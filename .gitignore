.gradle/
build/
out/
**/build/
**/.gradle/
*.iml
.DS_Store
__MACOSX/
local.properties
.env
.env.*
!.env.example
.idea/
.vscode/

# Office lock-files (trash, regenerated by Word/Excel while a doc is open)
~$*

# Local working artifacts (regenerable build/scratch outputs)
tmp/
output/
colab/.cache/
colab/*.zip
colab/*.apk
colab/*.aab

# Local-only agent settings
.claude/settings.local.json

# Python tooling caches / virtualenvs
__pycache__/
*.pyc
.venv/
venv/

# Regenerable kotlinc harness jars (recreated by tools/*/run.sh and build steps)
*.jar
!gradle/wrapper/gradle-wrapper.jar

# LaTeX build artifacts (main.tex and main.pdf are kept)
submission/**/*.aux
submission/**/*.log
submission/**/*.out
submission/**/*.toc

# Real model weights / audio / generated reports (never committed)
reports/*.json
reports/*.jsonl
reports/*.csv
reports/mac-cpu/
tools/real-mt-benchmark/outputs.tsv
# Local model cache used by host/JVM tests and device sync. Keep only the
# tracked top-level models/README.md + MODEL_MANIFEST.md in git.
models/speech_to_text/
models/translation/
models/vad/
models/text_to_speech/
models/**/*.onnx
models/**/*.tflite
models/**/*.dlc
models/**/*.bin
models/**/*.pt
models/**/*.pth
models/**/*.zip
models/**/io_report.json
testdata/**/*.wav
testdata/**/*.mp3

# Android release artifacts and local third-party AARs downloaded by Colab.
**/*.apk
**/*.aab
android/app/libs/

# Never store deployment or model-provider credentials in the repository.
*.pem
*.key
*.p12
*.keystore
*.jks
qaihub_config.json
.qai_hub/
.huggingface/

# Models bundled into the APK assets by colab/02_build_apk.ipynb (regenerable, huge)
android/app/src/main/assets/models/

# Model-cache switches are created by tools/dev/{restore,sync}-models.sh.
.models.restore.*/
.models.staging.*/
.models.previous.*/

# e2e JVM harness cache (Temurin JDK 17 / kotlinc / maven jars — auto-downloaded by tools/*/run.sh, ~500 MB)
tools/*/.cache/

# Local agent checkpoints (not project documentation).
/work/
